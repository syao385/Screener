# ==============================================================================
# SECURE LOCAL ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' (which is strictly gitignored by .gitignore).
# Never commit your secret keys, tokens, or passwords to version control.
# ==============================================================================

# 1. Alpaca Trading API Keys (Paper Free Tier default)
# Generate from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# 2. Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATION_LEVEL=ALL

# 3. Universal Webhook URL (Optional execution router)
WEBHOOK_EXECUTION_URL=
